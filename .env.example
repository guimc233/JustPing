# ==============================================================================
# JustPing Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Server Port
PORT=8080

# Application Public Host URL (Used for OAuth redirects)
APP_URL=http://localhost:8080

# PostgreSQL Connection String (or configure individual DB_* variables)
# Format: postgres://username:password@hostname:5432/dbname?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/justping?sslmode=disable

# Optional: Individual DB Variables (if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=justping
DB_SSLMODE=disable

# OAuth Configuration (Can also be configured via WebUI during first startup)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Generic OIDC / Custom OAuth (LinuxDo, Keycloak, Casdoor, etc.)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_NAME=oidc

# JWT Signing Secret (Leave empty to auto-generate)
JWT_SECRET=

# Server Mode (debug or release)
GIN_MODE=release
